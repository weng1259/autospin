  "errors": {
    "AlarmStateError": {
      "docstring": "grbl 当前在 ALARM 状态。",
      "error_code": "L3.ALARM_STATE",
      "recoverable": true,
      "severity": "alarm",
      "suggested_action": "Call unlock_alarm() or home() to recover.",
      "suggested_action_zh": "点「🔧 清除并恢复」一键 unlock + 重新归零。"
    },
    "BrakeError": {
      "docstring": "Z 轴刹车继电器（DSTUR-T80 CH2）操作失败。",
      "error_code": "L3.BRAKE",
      "recoverable": true,
      "severity": "alarm",
      "suggested_action": "DSTUR-T80 relay command failed on Z-brake channel; verify the USB serial port exists and is not held by another process.",
      "suggested_action_zh": "Z 轴刹车继电器命令失败。确认继电器串口存在且没被其它进程占用，再重试。"
    },
    "ConnectionError": {
      "docstring": "USB / 串口连接异常 —— 端口不存在、被占用、运行中突然拔线。",
      "error_code": "L3.CONNECTION",
      "recoverable": true,
      "severity": "alarm",
      "suggested_action": "Check USB cable and port; reconnect the backend.",
      "suggested_action_zh": "检查 USB 线和端口占用，然后在 sidebar 点「断开并重连」。"
    },
    "GrblConfigMismatchError": {
      "docstring": "grbl 关键 `$` 参数与仓库定义不一致。",
      "error_code": "L3.CONFIG_MISMATCH",
      "recoverable": true,
      "severity": "alarm",
      "suggested_action": "Repair grbl settings before attempting motion.",
      "suggested_action_zh": "grbl 关键参数不一致，请先修复参数再重新归零/运动。"
    },
    "HomingTimeoutError": {
      "docstring": "归零或运动指令在超时窗口内未完成。",
      "error_code": "L3.HOMING_TIMEOUT",
      "recoverable": true,
      "severity": "alarm",
      "suggested_action": "Homing did not complete; check brake release & sensors.",
      "suggested_action_zh": "归零/运动超时未完成。检查 Z 刹车（DSTUR CH2）和限位传感器（`$$` 看 `$5=1`），再重试归零。"
    },
    "L3Error": {
      "docstring": "",
      "error_code": "L3.UNKNOWN",
      "recoverable": false,
      "severity": "alarm",
      "suggested_action": "",
      "suggested_action_zh": ""
    },
    "MachineNotHomedError": {
      "docstring": "机器未归零，但调用了需要 homed 的方法（move_to 等）。",
      "error_code": "L3.MACHINE_NOT_HOMED",
      "recoverable": true,
      "severity": "warning",
      "suggested_action": "Call gantry.home() before attempting motion commands.",
      "suggested_action_zh": "先点「🏠 归零」按钮完成归零，再下运动指令。"
    },
    "OperationConflictError": {
      "docstring": "前一个操作还在执行，新请求被拒绝（Slice 3 移动期间再下指令）。",
      "error_code": "L3.OPERATION_CONFLICT",
      "recoverable": true,
      "severity": "warning",
      "suggested_action": "Wait for current operation to finish or call halt() first.",
      "suggested_action_zh": "机器正忙，请先点顶部「🛑 停」或等当前动作完成。"
    },
    "RelayCommunicationError": {
      "docstring": "DSTUR-T80 USB 继电器通信失败——端口不存在、被占用、write 超时、EMI 断联。\n\nPhase 3.3 起的通用继电器错误。Z 轴刹车专用的 `BrakeError` 是它的子类，\n`GantryBackend` 在 Z 刹车路径捕获本错误后包成 `BrakeError` 重新抛出。",
      "error_code": "L3.RELAY",
      "recoverable": true,
      "severity": "alarm",
      "suggested_action": "DSTUR-T80 command failed; verify USB port and retry; if persistent reconnect the relay backend.",
      "suggested_action_zh": "继电器命令失败。若单次瞬失可忽略重试；持续失败检查继电器串口存在且没被其它进程占用。"
    },
    "SoftLimitExceededError": {
      "docstring": "请求的目标坐标超过工作空间软限位。",
      "error_code": "L3.SOFT_LIMIT_EXCEEDED",
      "recoverable": false,
      "severity": "warning",
      "suggested_action": "Target outside work envelope; adjust Position fields.",
      "suggested_action_zh": "目标超出工作空间（见 sidebar「软限位」），请调整坐标输入。"
    }
  },
