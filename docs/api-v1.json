    "GripperActionPlan": {
      "$defs": {
        "GripperCommandedState": {
          "description": "夹爪命令状态——backend 记忆的最后一次开合命令。\n\n**不是真实位置**：继电器只控 24V 通断，无位置反馈。真实位置要 RS485\n查（Phase 3.5+ 的 `set_force` / 完整状态查询才引入）。\n\n`UNKNOWN` 用在 connect 前 / 未发任何开合命令的初始态。",
          "enum": [
            "open",
            "closed",
            "unknown"
          ],
          "title": "GripperCommandedState",
          "type": "string"
